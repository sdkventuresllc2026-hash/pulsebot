DISCORD_TOKEN=your-bot-token
CLIENT_ID=your-application-id
GUILD_ID=your-server-id
ADMIN_IDS=your-discord-user-id
# Optional: role that can use /admin commands without full Administrator permission
# MANAGER_ROLE_ID=
TZ=America/New_York

# Natural deal lines: channel name substrings (comma-separated). Empty = defaults below.
# Defaults: virginia-deals, greenville-deals
# DEAL_LOG_CHANNEL_NAMES=my-team-deals,other-deals
# Optional explicit channel IDs (comma-separated Discord snowflakes)
# DEAL_LOG_CHANNEL_IDS=

# Web dashboard (starts with the bot). API requires header X-Pulse-Key: <same value>
DASHBOARD_SECRET=change-me-to-a-long-random-string
DASHBOARD_PORT=3050
# Optional bind address (default 0.0.0.0)
# DASHBOARD_HOST=127.0.0.1
