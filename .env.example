DISCORD_TOKEN=your-bot-token
CLIENT_ID=your-application-id
GUILD_ID=your-server-id
ADMIN_IDS=your-discord-user-id
# Optional: role that can use /admin commands and see ALL market channels
# MANAGER_ROLE_ID=

# Bot needs Discord permissions: Manage Roles, Manage Channels, View Channels
# Reps: use /admin assign-rep (not manual "see all channels" roles)
TZ=America/New_York

# Railway: mount a volume at /data and set this so leaderboard + channel config persist across deploys
# PULSE_DATA_DIR=/data

# Natural deal lines: channel name substrings (comma-separated). Empty = defaults below.
# Defaults: virginia-deals, greenville-deals
# DEAL_LOG_CHANNEL_NAMES=my-team-deals,other-deals
# Optional explicit channel IDs (comma-separated Discord snowflakes)
# DEAL_LOG_CHANNEL_IDS=

# Web dashboard (starts with the bot). API requires header X-Pulse-Key: <same value>
DASHBOARD_SECRET=change-me-to-a-long-random-string
DASHBOARD_PORT=3050
# Optional bind address (default 0.0.0.0)
# DASHBOARD_HOST=127.0.0.1

# FiberSales OS sync for T-Fiber screenshot proof.
# Must match PULSE_OS_SECRET in the FiberSales OS deployment.
# FIBERSALES_OS_URL=https://fibersales.co
# PULSE_OS_SECRET=change-me-to-the-same-long-random-string
